<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 模拟器是纯控制台程序，只依赖 Core；ScottPlot 属于界面层，只加在 DeviceMonitor.App 上 -->
    <ProjectReference Include="..\DeviceMonitor.Core\DeviceMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog 配置文件要复制到输出目录（NLog 默认在 exe 同目录找 NLog.config） -->
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
