<Window x:Class="DeviceMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceMonitor.App"
        xmlns:viewmodels="clr-namespace:DeviceMonitor.App.ViewModels"
        xmlns:conv="clr-namespace:DeviceMonitor.App.Converters"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="DeviceMonitor - 串口设备采集监控" Height="760" Width="1220">

    <Window.Resources>
        <local:DeviceStateToBrushConverter x:Key="StateToBrush"/>
        <conv:AlarmLevelToBrushConverter x:Key="AlarmToBrush"/>
    </Window.Resources>
    <!--
        主窗口布局：工具栏 / 设备列表 / 实时表格 + 曲线 / 报警与日志 / 状态栏。
        见设计文档 §6.7。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="启动采集" Command="{Binding StartAllCommand}"/>
                <Button Content="停止采集" Command="{Binding StopAllCommand}"/>
                <Separator/>
                <Button Content="添加设备..." Command="{Binding AddDeviceCommand}"/>
                <Button Content="编辑设备..." Command="{Binding EditDeviceCommand}"/>
                <Button Content="删除设备" Command="{Binding RemoveDeviceCommand}"/>
                <Separator/>
                <Button Content="清空数据" Command="{Binding ClearPointsCommand}"/>
                <Button Content="历史查询..." Command="{Binding OpenHistoryCommand}"/>
                <Button Content="导出报表..." Command="{Binding OpenExportCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备列表 -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="设备列表" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StateText}" Foreground="#888" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PortName}" Foreground="#999" FontSize="11" Margin="16,2,0,0"/>
                                    <TextBlock Text="{Binding LastError}" Foreground="#C33" FontSize="11" TextWrapping="Wrap" Margin="16,2,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Points}" Margin="16,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11" Foreground="#666">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" = "/>
                                                    <Run Text="{Binding DisplayText, Mode=OneWay}"/>
                                                    <Run Text="{Binding Unit, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：实时表格 + 曲线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEE"/>
            <Grid Grid.Column="2" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="230" MinHeight="90"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ==================== 实时数据表 ==================== -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding AllPoint}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          EnableRowVirtualization="True"
                          RowHeight="26"
                          FontSize="12"
                          AlternationCount="2"
                          BorderBrush="#DDD" BorderThickness="1">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,5"/>
                            <Setter Property="Background" Value="#F3F3F3"/>
                            <Setter Property="BorderBrush" Value="#DDD"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}"
                                             Value="1">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </DataTrigger>

                                <!-- 报警底色：声明顺序在后 → 优先级高于斑马纹 -->
                                <DataTrigger Binding="{Binding IsLowAlarm}" Value="True">
                                    <Setter Property="Background" Value="#FFF6E8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHighAlarm}" Value="True">
                                    <Setter Property="Background" Value="#FDEDED"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Device.IsOnline}" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <!-- 在线状态圆点 -->
                        <DataGridTemplateColumn Header="状态" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding Device.State, Converter={StaticResource StateToBrush}}"/>
                                        <TextBlock Text="{Binding Device.StateText}" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel> 
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            
                            
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="*" MinWidth="90"/>
                        <DataGridTextColumn Header="点位" Binding="{Binding Name}" Width="*" MinWidth="80"/>
                        <DataGridTextColumn Header="原始值" Binding="{Binding RawText}" Width="76">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#555"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="工程值" Binding="{Binding DisplayText}" Width="92">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLowAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="#C77700"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="#D13A3A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="52">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#777"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="限值（低~高）" Binding="{Binding LimitText}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#999"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="报警" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="{Binding LimitText, StringFormat='限值 {0}'}">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding AlarmLevel, Converter={StaticResource AlarmToBrush}}"/>
                                        <TextBlock Text="{Binding AlarmText}" Margin="5,0,0,0"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{Binding AlarmLevel, Converter={StaticResource AlarmToBrush}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding LastUpdatedText}" Width="106">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#666" />
                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#EEE"/>
                <!-- 曲线区 -->
                <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1">
                    <sp:WpfPlot x:Name="CurvePlot"/>
                </Border>

                <TabControl Grid.Row="3" Height="170" Margin="0,8,0,0">
                    <TabItem Header="{Binding Alarms.SummaryText}">

                        <DataGrid ItemsSource="{Binding Alarms.Rows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  EnableRowVirtualization="True"
                                  RowHeight="22" FontSize="12"
                                  BorderThickness="0">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="Background" Value="#F3F3F3"/>
                                    <Setter Property="BorderBrush" Value="#DDD"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>


                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlarm}" Value="False">
                                            <Setter Property="Foreground" Value="#999"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="80"/>
                                <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="130"/>
                                <DataGridTextColumn Header="点位" Binding="{Binding PointName}" Width="90"/>
                                <DataGridTextColumn Header="工程值" Binding="{Binding ValueText}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="类别" Binding="{Binding KindText}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlarm}" Value="False">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                    </TabItem>
                    <TabItem Header="运行日志">
                        <TextBlock Text="运行日志" Margin="10" Foreground="#999"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StateText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="累计样本 "/><Run Text="{Binding ReceivedSampleCount,Mode=OneWay}"/>
                    <Run Text=" 最后刷新 "/><Run Text="{Binding LastRefreshText, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
