<Window x:Class="DeviceMonitor.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:viewmodels="clr-namespace:DeviceMonitor.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:HistoryViewModel}"
        mc:Ignorable="d"
        Title="历史查询与回放" Height="720" Width="1120">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="240" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <WrapPanel>
                <TextBlock Text="设备" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="100" ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"/>
                <TextBlock Text="时间段" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox Width="120" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>

                <!-- 只有选「自定义」时才出现这两个输入框（本地时间） -->
                <TextBlock Text="起始" VerticalAlignment="Center" Margin="16,0,6,0"
                           Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}"/>
                <TextBox Width="150" VerticalContentAlignment="Center"
                         Text="{Binding CustomFromText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="结束" VerticalAlignment="Center" Margin="10,0,6,0"
                           Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}"/>
                <TextBox Width="150" VerticalContentAlignment="Center"
                         Text="{Binding CustomToText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}"/>

                <Button Content="查询" Width="80" Padding="0,4" Margin="16,0,0,0" IsDefault="True"
                        Command="{Binding QueryCommand}"/>
                <Button Content="关闭" Width="70" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="点位" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ItemsControl ItemsSource="{Binding Points}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="全选" Padding="8,0" Margin="8,0,0,0" Command="{Binding SelectAllPointsCommand}"/>
                <Button Content="全不选"  Padding="8,0" Margin="4,0,0,0" Command="{Binding ClearPointSelectionCommand}"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Margin="0,8,0,0">
            <sp:WpfPlot x:Name="HistoryPlot"/>
        </Border>
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#EEE"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True"
                  RowHeight="24" FontSize="12"
                  BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,5"/>
                    <Setter Property="Background" Value="#F3F3F3"/>
                    <Setter Property="BorderBrush" Value="#DDD"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="时间（本地）" Width="180"
                                    Binding="{Binding TsLocal, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"/>
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="140"/>
                <DataGridTextColumn Header="点位" Binding="{Binding PointName}" Width="*" MinWidth="90"/>
                <DataGridTextColumn Header="工程值" Binding="{Binding ValueText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="0,0,6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#777"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Foreground="#444"/>
    </Grid>
</Window>
