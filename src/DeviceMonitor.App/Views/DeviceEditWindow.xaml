<Window  x:Class="DeviceMonitor.App.Views.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMonitor.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:DeviceEditViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DeviceMonitor.App.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NotEmptyToBoolConverter x:Key="NoErrorToBool"/>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 串口参数 -->
        <GroupBox Grid.Row="0" Header="串口与从站参数" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="设备名" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="串口号" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="0" Grid.Column="3" IsEditable="True" ItemsSource="{Binding AvailablePorts}"
                          Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="从站地址" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="波特率" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="数据位" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="校验位" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="停止位" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="读超时(ms)" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ReadTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="2" Grid.Column="4" Text="轮询(ms)" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6"/>
            </Grid>
        </GroupBox>

        <!-- 点位表 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="采集点位" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="添加点位" Command="{Binding AddPointCommand}" Margin="12,0,0,0" Padding="8,2"/>
                <TextBlock Text="（提示：至少启用一个点位，否则采集无法启动）" Foreground="#888" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      CellEditEnding="OnPointsCellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                    <DataGridTextColumn Header="功能码" Binding="{Binding FunctionCode, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="起始地址" Binding="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="缩放" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="小数点" Binding="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="上限" Binding="{Binding AlarmHigh, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="下限" Binding="{Binding AlarmLow, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="死区" Binding="{Binding AlarmDeadband, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTemplateColumn Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除" Command="{Binding DataContext.RemovePointCommand ,RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <!-- 校验提示条 -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8"
                Background="#FFF4F4" BorderBrush="#E9A0A0" BorderThickness="1"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="#B22" TextWrapping="Wrap"/>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <!--
                "确定"的可用性由 ErrorText 决定（空=可点）。灰掉时鼠标悬停能看到原因 ——
                否则用户面对一个点不动的按钮毫无头绪（本窗口就出过"按钮永远点不了"的事故）。
            -->
            <Button Content="确定" IsDefault="True" Width="90" Padding="0,4" Click="OnConfirmClick"
                    IsEnabled="{Binding ErrorText, Converter={StaticResource NoErrorToBool}}"
                    ToolTip="{Binding ErrorText}"/>
            <Button Content="取消" IsCancel="True"  Width="90" Padding="0,4" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
