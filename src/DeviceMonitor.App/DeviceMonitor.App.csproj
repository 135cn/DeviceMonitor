<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<!-- MVVM：源生成器 [ObservableProperty] / [RelayCommand] -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<!-- DI 容器（8.0.0 与 net8.0 配套） -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 注意：这是 plain ScottPlot，D18 画曲线要换成 ScottPlot.WPF（含 WPF 控件），
         现在不用可以先删掉，省 5MB 的 SkiaSharp 原生库 -->
		<PackageReference Include="ScottPlot" Version="5.1.59" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DeviceMonitor.Core\DeviceMonitor.Core.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

</Project>