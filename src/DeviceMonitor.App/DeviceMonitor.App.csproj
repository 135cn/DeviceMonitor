<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<!-- MVVM：源生成器 [ObservableProperty] / [RelayCommand] -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<!-- DI 容器（8.0.0 与 net8.0 配套） -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DeviceMonitor.Core\DeviceMonitor.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- NLog 配置文件要复制到输出目录，否则运行时找不到（NLog 默认在 exe 同目录找 NLog.config） -->
		<None Update="NLog.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

</Project>