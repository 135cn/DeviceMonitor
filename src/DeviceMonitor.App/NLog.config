<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 配置（D14 日志接入）。

  输出目标：
    1. 文件  logs/devicemonitor-${shortdate}.log —— 按天滚动，保留 7 天，给"事后排查"用；
    2. 控制台 —— 方便 Simulator 与调试时直接看。

  级别说明（排查问题时的用法）：
    - Warn/Error 是默认可见的，容错路径（关闭通道失败、坏配置文件、订阅方异常、泵任务崩溃）
      都在这一档，出现即代表有过异常；
    - 采集连续失败会从第 2 次起降到 Debug，避免"设备离线"时把日志刷爆；
      需要看每一次失败详情时把下面 minlevel 改成 Debug 即可。

  ⚠️ 文件写入目录是 exe 所在目录下的 logs/（WPF 是 bin\Debug\net8.0-windows\logs）。
     项目 .gitignore 已忽略日志文件。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Off">

  <targets>
    <target xsi:type="File" name="logfile"
            fileName="${basedir}/logs/devicemonitor-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=tostring}}"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="true"
            archiveAboveSize="5242880"
            maxArchiveFiles="7" />

    <target xsi:type="Console" name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Core 与服务层的日志走文件 + 控制台 -->
    <logger name="*" minlevel="Info" writeTo="logfile" />
    <logger name="DeviceMonitor.*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
