<?xml version="1.0" encoding="utf-8" ?>
<!--
  MasterConsole 的 NLog 配置（D12 端到端验证工具）。

  控制台程序自己已经在实时打印状态与统计，日志只做"事后排查"的补充：
  控制台压到 Warning，文件保留 Info。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Off">

  <targets>
    <target xsi:type="File" name="logfile"
            fileName="${basedir}/logs/masterconsole-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=tostring}}"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="true"
            maxArchiveFiles="7" />

    <target xsi:type="Console" name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logfile" />
    <!-- 保住控制台自己的实时输出，只放警告以上 -->
    <logger name="DeviceMonitor.*" minlevel="Warn" writeTo="console" />
  </rules>
</nlog>
